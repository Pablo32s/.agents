# =================================================================
# CONFIGURACIÓN DEL ENTORNO — MÓDULO SATÉLITE CGE / SAGE
# =================================================================

# 1. Seguridad Dinámica SAGE
# Grupos de Super Usuario (Devs, Testers, QA - Bypass total en sesión y BD):
SUPER_USER_GROUP=55,75

# Rol específico requerido para este módulo en vw_UsuariosRolesPermisos:
REQUIRED_ROLE_ID=576

# 2. Criptografía y Ofuscación de IDs / URLs (Clave simétrica para Crypto)
# Debe ser una cadena aleatoria y segura de al menos 16 o 32 caracteres
APP_KEY=cambiar_esta_clave_secreta_en_produccion_cge_2026

# 3. Directorio de Almacenamiento Aislado para este Módulo
# Ruta física del servidor para documentos y PDFs (usado por verArchivo y SharedFileStorage)
STORAGE_PATH=/archivos/mi_modulo

# 4. Conexión a Base de Datos (Solo para desarrollo local / standalone)
# En producción, App\Config\DB conecta automáticamente vía /dic/includes/connDB.inc.php
DB_HOST=localhost
DB_NAME=sage_db
DB_USER=root
DB_PASS=secret
