# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO — MÓDULO SATÉLITE CGE / SAGE (PHP 8.5 + SQL SERVER)
# ==============================================================================

# 1. Seguridad Dinámica SAGE
# Grupos de Super Usuario (Devs, Testers, QA - Bypass total en sesión y BD):
SUPER_USER_GROUP=55,75

# Roles habilitados en dbo.vw_UsuariosRolesPermisos para este módulo (separados por coma):
REQUIRED_ROLE_ID=576

# IDs opcionales de ítems en tb_MenuPrincipal:
MENU_PRINCIPAL_ID=

# 2. Criptografía y Ofuscación de IDs / URLs (Anti-IDOR - Clave simétrica para Crypto)
APP_KEY=cambiar_esta_clave_secreta_en_produccion_cge_2026

# 3. Directorio de Almacenamiento Aislado para este Módulo (verArchivo / SharedFileStorage)
STORAGE_PATH=/archivos/mi_modulo

# 4. Conexión a Base de Datos SQL Server (Desarrollo local / CLI cge-test)
# En servidor web SAGE conecta vía /dic/includes/connDB.inc.php o pregase/includes/.env
DB_DRIVER=sqlsrv
DB_HOST=10.10.23.12
DB_PORT=1433
DB_DATABASE=Sage_php
DB_USERNAME=usuarioweb
DB_PASSWORD=
